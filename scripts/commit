#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ $# -ne 1 ]]; then
  echo 'Usage: scripts/commit "type(optional-scope): description"' >&2
  exit 2
fi

if git diff --cached --quiet; then
  echo "No staged changes to commit." >&2
  exit 1
fi

python3 scripts/validate_commit.py --message "$1"

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit is not installed. Run scripts/setup first." >&2
  exit 1
fi

pre-commit run
git commit -m "$1"
