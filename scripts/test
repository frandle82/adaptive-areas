#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Which version(s) to run: default = stable
CHOICE="${1:-stable}"

# Stable uses the supported release pinned as default in tox.ini (ha-stable).
# Beta is advisory and still follows the newest beta on PyPI.
latest_beta() {
  curl -s https://pypi.org/pypi/homeassistant/json \
    | jq -r '.releases | keys | .[]' \
    | grep 'b' | sort -Vr | head -n1
}

case "$CHOICE" in
  stable)
    echo "Running tests against the supported Home Assistant stable release (tox.ini default)"
    tox -e ha-stable
    ;;
  beta)
    HA_BETA_VERSION=$(latest_beta)
    export HA_BETA_VERSION
    echo "Running tests against Home Assistant beta: $HA_BETA_VERSION"
    tox -e ha-beta
    ;;
  both)
    HA_BETA_VERSION=$(latest_beta)
    export HA_BETA_VERSION
    echo "Running tests against stable (tox.ini default) and beta ($HA_BETA_VERSION)"
    tox -e ha-stable,ha-beta
    ;;
  *)
    echo "Usage: $0 [stable|beta|both]"
    exit 1
    ;;
esac
